
#include <ESP32Servo.h>

// ================= L298N MOTOR DRIVER =================
#define ENA 25
#define IN1 26
#define IN2 27

#define ENB 33
#define IN3 18
#define IN4 19

// ================= ULTRASONIC SENSOR =================
#define TRIG 5
#define ECHO 34

// ================= SERVO MOTOR =================
#define SERVO_PIN 13
Servo scanner;

// ================= Initials =================
const int SPEED = 255;
const int OBSTACLE_DISTANCE = 25;

const int TURN_TIME = 450;
const int BACKUP_TIME = 250;

const int LEFT_ANGLE = 150;
const int CENTER_ANGLE = 90;
const int RIGHT_ANGLE = 50;


// ================= MOTOR FUNCTIONS =================

void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, SPEED);
  analogWrite(ENB, SPEED);
}

void moveBackward() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  analogWrite(ENA, SPEED);
  analogWrite(ENB, SPEED);
}

void turnLeft() {
  // Left motor backward, right motor forward
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  analogWrite(ENA, SPEED);
  analogWrite(ENB, SPEED);
}

void turnRight() {
  // Left motor forward, right motor backward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  analogWrite(ENA, SPEED);
  analogWrite(ENB, SPEED);
}

void stopMotors() {
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}


// ================= DISTANCE FUNCTION =================

float getDistance() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  unsigned long duration = pulseIn(ECHO, HIGH, 30000);

  if (duration == 0) {
    return -1;  // No echo received
  }

  return duration * 0.0343 / 2.0;
}


// ================= SERVO SCANNING =================

float scanAt(int angle) {
  scanner.write(angle);
  delay(500);

  float total = 0;
  int validReadings = 0;

  for (int i = 0; i < 3; i++) {
    float distance = getDistance();

    if (distance > 0) {
      total += distance;
      validReadings++;
    }

    delay(60);
  }

  if (validReadings == 0) {
    return -1;
  }

  return total / validReadings;
}


// ================= OBSTACLE AVOIDANCE =================

void avoidObstacle() {
  stopMotors();
  delay(300);

  Serial.println("\nObstacle detected!");
  Serial.println("Scanning left and right...");

  float leftDistance = scanAt(LEFT_ANGLE);
  float rightDistance = scanAt(RIGHT_ANGLE);

  scanner.write(CENTER_ANGLE);
  delay(300);

  Serial.print("Left distance: ");
  Serial.print(leftDistance);
  Serial.println(" cm");

  Serial.print("Right distance: ");
  Serial.print(rightDistance);
  Serial.println(" cm");

  bool leftBlocked =
      (leftDistance < 0 ||
       leftDistance <= OBSTACLE_DISTANCE);

  bool rightBlocked =
      (rightDistance < 0 ||
       rightDistance <= OBSTACLE_DISTANCE);

  // Both sides blocked or readings invalid
  if (leftBlocked && rightBlocked) {
    Serial.println("Both sides blocked. Reversing.");

    moveBackward();
    delay(BACKUP_TIME);
    stopMotors();
    delay(200);

    // If neither side has a valid reading,
    // choose a cautious default turn.
    if (leftDistance < 0 && rightDistance < 0) {
      turnRight();
      delay(TURN_TIME);
    }
    else if (leftDistance >= rightDistance) {
      turnLeft();
      delay(TURN_TIME);
    }
    else {
      turnRight();
      delay(TURN_TIME);
    }
  }

  // Left side has more space
  else if (leftDistance > rightDistance) {
    Serial.println("Turning LEFT");

    turnLeft();
    delay(TURN_TIME);
  }

  // Right side has more space
  else {
    Serial.println("Turning RIGHT");

    turnRight();
    delay(TURN_TIME);
  }

  stopMotors();
  delay(200);
}


// ================= SETUP =================

void setup() {
  Serial.begin(115200);

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  scanner.setPeriodHertz(50);
  scanner.attach(SERVO_PIN, 500, 2400);
  scanner.write(CENTER_ANGLE);

  stopMotors();

  delay(1000);

  Serial.println("================================");
  Serial.println("ESP32 OBSTACLE AVOIDANCE ROVER");
  Serial.println("System ready!");
  Serial.println("================================");
}


// ================= MAIN LOOP =================

void loop() {
  // Keep sensor facing forward
  scanner.write(CENTER_ANGLE);

  float frontDistance = getDistance();

  Serial.print("Front distance: ");
  Serial.print(frontDistance);
  Serial.println(" cm");

  // Stop if no echo is received
  if (frontDistance < 0) {
    stopMotors();
    delay(100);
    return;
  }

  // Obstacle detected within threshold
  if (frontDistance <= OBSTACLE_DISTANCE) {
    avoidObstacle();
  }
  else {
    moveForward();
  }

  delay(50);
}
